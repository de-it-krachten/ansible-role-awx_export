---

# Generic
generic:
  role: ansible-role-awx_export
  role_short: awx_export
  role_description: |
    export AWX configuration into JSON
  collections: []

# Supported platforms
platforms:
  rockylinux8:
    supported: true
    ci: false
  rockylinux9:
    supported: true
    ci: false
  rockylinux10:
    supported: true
    ci: false
  oraclelinux8:
    supported: true
    ci: false
  oraclelinux9:
    supported: true
    ci: false
  oraclelinux10:
    supported: true
    ci: false
  olam8:
    supported: false
    ci: true
  almalinux8:
    supported: true
    ci: false
  almalinux9:
    supported: true
    ci: false
  almalinux10:
    supported: true
    ci: false
  debian11:
    supported: true
    ci: false
  debian12:
    supported: true
    ci: false
  debian13:
    supported: true
    ci: false
  ubuntu2004:
    supported: true
    ci: false
  ubuntu2204:
    supported: true
    ci: false
  ubuntu2404:
    supported: true
    ci: false
  ubuntu2604:
    supported: true
    ci: false
  fedora43:
    supported: true
    ci: false
  fedora44:
    supported: true
    ci: false

# Dependencies 
dependencies:
  roles: 
    - deitkrachten.awx_cli
  collections:
    - awx.awx

# Molecule
molecule:
  phase1: []
  requirements:
    roles_extra:
      - deitkrachten.awx_cli
  prepare:
    vars:
      activate_epel: true
  converge:
    pre: converge-pre.yml
    become: "no"
    vars:
      awx_command: /usr/local/bin/awx
      awx_export_path: /tmp/awx
      awx_url: https://127.0.0.1
      awx_username: admin
      awx_password: "Admin123!"
      awx_verify_ssl: false
